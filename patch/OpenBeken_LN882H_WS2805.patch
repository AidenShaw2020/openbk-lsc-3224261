+bool SPIDMA_SetDuplex(bool full) {
+	if (!ln_spi_initialized) return false;
+	SPIDMA_StopTX();
+	hal_spi_en(SPI0_BASE, HAL_DISABLE);
+	hal_spi_set_bidirectional_line(SPI0_BASE, full ? SPI_DIRECTION_2LINES_FULLDUPLEX : SPI_DIRECTION_1LINE_TX);
+	ln_full_duplex = full;
+	hal_spi_en(SPI0_BASE, HAL_ENABLE);
+	return true;
+}
+
+bool SPIDMA_SetWS2805Mode(bool enabled) {
+	// SPI0 is on APB0. Reject unsupported clock profiles rather than send bad pulses.
+	if (enabled && hal_clock_get_apb0_clk() != 40000000U) {
+		ADDLOG_ERROR(LOG_FEATURE_DRV, "WS2805 requires APB0 40MHz, got %u", (unsigned int)hal_clock_get_apb0_clk());
+		return false;
+	}
+	ws2805_mode = enabled;
+	// Hardware-verified: in full duplex SPI0 drives MOSI only while shifting,
+	// so P6 floated high between frames and WS2805 ICs stopped accepting data
+	// until power-cycled. 1-line TX keeps MOSI driven low while idle.
+	ln_full_duplex = !enabled;
+	return true;
+}
+
+void SPIDMA_StopTX(void) {
+	if (!ln_spi_initialized) return;
+	hal_dma_en(DMA_CH_4, HAL_DISABLE);
+	hal_spi_dma_en(SPI0_BASE, SPI_DMA_TX_EN, HAL_DISABLE);
+	hal_dma_clr_status_flag(DMA_CH_4, DMA_STATUS_FLAG_TRAN_GLOB);
