diff --git a/src/driver/drv_ws2805.c b/src/driver/drv_ws2805.c
new file mode 100644
index 0000000..23a0fa4
--- /dev/null
+++ b/src/driver/drv_ws2805.c
@@ -0,0 +1,212 @@
+#include "../new_common.h"
+#include "../new_cfg.h"
+#include "../new_pins.h"
+#include "../cmnds/cmd_public.h"
+#include "../logging/logging.h"
+#include "drv_local.h"
+#include "drv_leds_shared.h"
+#include "drv_spidma.h"
+
+#if ENABLE_DRIVER_SM16703P && PLATFORM_LN882H
+#include "ws2805_encode.h"
+#include "hal/hal_clock.h"
+#include "hal/hal_gpio.h"
+#include "../hal/hal_pins.h"
+#include "../hal/hal_generic.h"
+
+// One-shot diagnostic only: copied into RAM by the SDK's .data* linker rule.
+// Absolute cycle deadlines avoid flash/cache latency and byte-boundary gaps.
+// IRQs are masked for <=520us (10 pixels); do not use as an IR-safe backend.
+__attribute__((section(".data.ws2805_probe"), noinline))
+static void WS2805_GPIOProbe(const byte *data, unsigned count, unsigned mhz) {
+	volatile uint32_t *bsrr = &((t_hwp_gpio_t*)GPIOA_BASE)->gpio_bsrr.val;
+	uint32_t deadline = DWT->CYCCNT + 64;
+	uint32_t cell = mhz * 13 / 10;
+	for (unsigned n=0; n<count; n++) {
+		for (unsigned mask=128; mask; mask>>=1) {
+			uint32_t high = (data[n] & mask) ? mhz * 7 / 10 : mhz * 3 / 10;
+			while ((int32_t)(DWT->CYCCNT - deadline) < 0) { }
+			*bsrr = GPIO_PIN_6;
+			uint32_t falling = deadline + high;
+			while ((int32_t)(DWT->CYCCNT - falling) < 0) { }
+			*bsrr = (uint32_t)GPIO_PIN_6 << 16;
+			deadline += cell;
+		}
+	}
+}
+
+extern int spidma_led_pin;
+extern commandResult_t Strip_CMD_InitForLEDCount(const void *, const char *, const char *, int);
+extern commandResult_t Strip_CMD_setPixel(const void *, const char *, const char *, int);
+extern commandResult_t Strip_CMD_setRaw(const void *, const char *, const char *, int);
+static byte *raw;
+static struct spi_message tx;
+static uint32_t source_bytes;
+static uint32_t failures;
+static bool active;
+static bool last_send_ok;
+// Retained across start/stop, like the core driver mutex. One allocation only;
+// callbacks already queued by HTTP/QuickTick can safely lock after shutdown.
+static SemaphoreHandle_t buffer_mutex;
+
+static bool WS2805_Ready() { return active && raw && tx.send_buf; }
+
+static void WS2805_FreeBuffers() {
+	SPIDMA_StopTX();
+	SPIDMA_Deinit();
+	os_free(raw);
+	os_free(tx.send_buf);
+	raw = NULL;
+	memset(&tx, 0, sizeof(tx));
+	source_bytes = 0;
+}
+
+static byte WS2805_GetByte(uint32_t idx) {
+	if (!buffer_mutex) return 0;
+	xSemaphoreTake(buffer_mutex, portMAX_DELAY);
+	byte value = WS2805_Ready() && idx < source_bytes ? raw[idx] : 0;
+	xSemaphoreGive(buffer_mutex);
+	return value;
+}
+static void WS2805_SetByte(uint32_t idx, byte val) {
+	if (!buffer_mutex) return;
+	xSemaphoreTake(buffer_mutex, portMAX_DELAY);
+	if (WS2805_Ready() && idx < source_bytes) raw[idx] = val;
+	xSemaphoreGive(buffer_mutex);
+}
+// Wire byte n of the 6-byte-per-pixel frame; every sixth byte is the zero pad.
+static byte WS2805_WireByte(uint32_t n) {
+	uint32_t ch = n % WS2805_WIRE_BYTES_PER_PIXEL;
+	return ch < WS2805_CHANNELS ? raw[n / WS2805_WIRE_BYTES_PER_PIXEL * WS2805_CHANNELS + ch] : 0;
+}
+static void WS2805_Show() {
+	if (!buffer_mutex) return;
+	xSemaphoreTake(buffer_mutex, portMAX_DELAY);
+	last_send_ok = false;
+	if (!WS2805_Ready()) { xSemaphoreGive(buffer_mutex); return; }
+	uint32_t wire_bytes = source_bytes / WS2805_CHANNELS * WS2805_WIRE_BYTES_PER_PIXEL;
+	for (uint32_t i = 0; i < wire_bytes; i++)
+		WS2805_EncodeByte(WS2805_WireByte(i), tx.send_buf + i * WS2805_ENCODED_BYTES);
+	last_send_ok = SPIDMA_StartTXChecked(&tx);
+	if (!last_send_ok) failures++;
+	xSemaphoreGive(buffer_mutex);
+}
+static void WS2805_SetCount(int count, int size) {
+	xSemaphoreTake(buffer_mutex, portMAX_DELAY);
+	WS2805_FreeBuffers();
+	if (!active || count < 1 || count > 255 || size != 5) { xSemaphoreGive(buffer_mutex); return; }
+	source_bytes = count * WS2805_CHANNELS;
+	tx.send_len = count * WS2805_WIRE_BYTES_PER_PIXEL * WS2805_ENCODED_BYTES + WS2805_RESET_BYTES;
+	raw = os_malloc(source_bytes);
+	tx.send_buf = os_malloc(tx.send_len);
+	if (!raw || !tx.send_buf) {
+		WS2805_FreeBuffers();
+		ADDLOG_ERROR(LOG_FEATURE_DRV, "WS2805 allocation failed");
+		xSemaphoreGive(buffer_mutex);
+		return;
+	}
+	memset(raw, 0, source_bytes);
+	memset(tx.send_buf, 0, tx.send_len);
+	SPIDMA_Init(&tx);
+	ADDLOG_INFO(LOG_FEATURE_DRV, "WS2805 %d pixels, 6 wire bytes/pixel, SPI=20MHz, cell=1300ns, reset=320us", count);
+	xSemaphoreGive(buffer_mutex);
+}
+static commandResult_t WS2805_CMD_Init(const void *ctx, const char *cmd, const char *args, int flags) {
+	if (!active) return CMD_RES_ERROR;
+	return Strip_CMD_InitForLEDCount(ctx, cmd, args, flags);
+}
+static commandResult_t WS2805_CMD_Start(const void *ctx, const char *cmd, const char *args, int flags) {
+	WS2805_Show();
+	return last_send_ok ? CMD_RES_OK : CMD_RES_ERROR;
+}
+static commandResult_t WS2805_CMD_Pixel(const void *ctx, const char *cmd, const char *args, int flags) {
+	if (!active) return CMD_RES_ERROR;
+	return Strip_CMD_setPixel(ctx, cmd, args, flags);
+}
+static commandResult_t WS2805_CMD_Raw(const void *ctx, const char *cmd, const char *args, int flags) {
+	if (!active) return CMD_RES_ERROR;
+	commandResult_t result = Strip_CMD_setRaw(ctx, cmd, args, flags);
+	if (result == CMD_RES_OK && Tokenizer_GetArgInteger(0) && !last_send_ok) return CMD_RES_ERROR;
+	return result;
+}
+static commandResult_t WS2805_CMD_Status(const void *ctx, const char *cmd, const char *args, int flags) {
+	if (buffer_mutex) xSemaphoreTake(buffer_mutex, portMAX_DELAY);
+	ADDLOG_INFO(LOG_FEATURE_DRV, "WS2805 ready=%d bytes=%u DMA failures=%u", WS2805_Ready(),
+		(unsigned int)source_bytes, (unsigned int)failures);
+	SPIDMA_LogStatus();
+	if (WS2805_Ready()) ADDLOG_INFO(LOG_FEATURE_DRV, "WS2805 first wire bytes %02X %02X %02X %02X %02X", raw[0],raw[1],raw[2],raw[3],raw[4]);
+	if (buffer_mutex) xSemaphoreGive(buffer_mutex);
+	return CMD_RES_OK;
+}
+static commandResult_t WS2805_CMD_Duplex(const void *ctx, const char *cmd, const char *args, int flags) {
+	Tokenizer_TokenizeString(args, 0);
+	if (!active || Tokenizer_GetArgsCount() != 1) return CMD_RES_BAD_ARGUMENT;
+	int mode = Tokenizer_GetArgInteger(0);
+	if (mode < 0 || mode > 1) return CMD_RES_BAD_ARGUMENT;
+	xSemaphoreTake(buffer_mutex, portMAX_DELAY);
+	bool ok = SPIDMA_SetDuplex(mode != 0);
+	xSemaphoreGive(buffer_mutex);
+	return ok ? CMD_RES_OK : CMD_RES_ERROR;
+}
+static commandResult_t WS2805_CMD_GPIOProbe(const void *ctx, const char *cmd, const char *args, int flags) {
+	if (!buffer_mutex) return CMD_RES_ERROR;
+	xSemaphoreTake(buffer_mutex, portMAX_DELAY);
+	if (!WS2805_Ready() || source_bytes > 50) { xSemaphoreGive(buffer_mutex); return CMD_RES_ERROR; }
+	CoreDebug->DEMCR |= CoreDebug_DEMCR_TRCENA_Msk;
+	DWT->CTRL |= DWT_CTRL_CYCCNTENA_Msk;
+	uint32_t before = DWT->CYCCNT;
+	for (volatile int i=0; i<100; i++) __NOP();
+	unsigned mhz = hal_clock_get_core_clk()/1000000U;
+	if (DWT->CYCCNT == before || mhz < 80 || mhz > 160) { xSemaphoreGive(buffer_mutex); return CMD_RES_ERROR; }
+	byte wire[10 * WS2805_WIRE_BYTES_PER_PIXEL];
+	unsigned wire_bytes = source_bytes / WS2805_CHANNELS * WS2805_WIRE_BYTES_PER_PIXEL;
+	for (unsigned i = 0; i < wire_bytes; i++) wire[i] = WS2805_WireByte(i);
+	SPIDMA_Deinit();
+	vTaskDelay(pdMS_TO_TICKS(5)+1);
+	uint32_t irq = __get_PRIMASK();
+	__disable_irq();
+	WS2805_GPIOProbe(wire, wire_bytes, mhz);
+	__set_PRIMASK(irq);
+	vTaskDelay(pdMS_TO_TICKS(5)+1);
+	SPIDMA_Init(&tx);
+	ADDLOG_INFO(LOG_FEATURE_DRV, "WS2805 GPIO probe: %u bytes core=%uMHz (one-shot, waveform unmeasured)", (unsigned int)source_bytes,mhz);
+	xSemaphoreGive(buffer_mutex);
+	return CMD_RES_OK;
+}
+void WS2805_Init() {
+	int pin = PIN_FindPinIndexForRole(IOR_SM16703P_DIN, -1);
+	if (pin != 6 || Strip_IsActive() || !SPIDMA_SetWS2805Mode(true)) {
+		ADDLOG_ERROR(LOG_FEATURE_DRV, "WS2805 needs P6=SM16703P_DIN and no active strip backend");
+		return;
+	}
+	spidma_led_pin = pin;
+	if (!buffer_mutex) buffer_mutex = xSemaphoreCreateMutex();
+	if (!buffer_mutex) { SPIDMA_SetWS2805Mode(false); return; }
+	active = true;
+	failures = 0;
+	ledStrip_t api = { 0 };
+	api.apply = WS2805_Show;
+	api.getByte = WS2805_GetByte;
+	api.setByte = WS2805_SetByte;
+	api.setLEDCount = WS2805_SetCount;
+	api.isReady = WS2805_Ready;
+	api.requiredPixelSize = 5;
+	LEDS_InitShared(&api);
+	CMD_RegisterCommand("WS2805_Init", WS2805_CMD_Init, NULL);
+	CMD_RegisterCommand("WS2805_Start", WS2805_CMD_Start, NULL);
+	CMD_RegisterCommand("WS2805_Status", WS2805_CMD_Status, NULL);
+	CMD_RegisterCommand("WS2805_Duplex", WS2805_CMD_Duplex, NULL);
+	CMD_RegisterCommand("WS2805_GPIOProbe", WS2805_CMD_GPIOProbe, NULL);
+	CMD_RegisterCommand("WS2805_SetPixel", WS2805_CMD_Pixel, NULL);
+	CMD_RegisterCommand("WS2805_SetRaw", WS2805_CMD_Raw, NULL);
+}
+void WS2805_Shutdown() {
+	if (!active) return;
+	xSemaphoreTake(buffer_mutex, portMAX_DELAY);
+	active = false;
+	LEDS_ShutdownShared();
+	WS2805_FreeBuffers();
+	SPIDMA_SetWS2805Mode(false);
+	xSemaphoreGive(buffer_mutex);
+}
+#endif
diff --git a/src/driver/ws2805_encode.h b/src/driver/ws2805_encode.h
new file mode 100644
index 0000000..c900bc3
--- /dev/null
+++ b/src/driver/ws2805_encode.h
@@ -0,0 +1,25 @@
+#pragma once
+#include <stdint.h>
+#include <string.h>
+
+// APB0=40MHz, SPI /2=20MHz (50ns per bit). Each source bit is 26 SPI
+// bits: 0 = 7 high + 19 low (350ns/950ns), 1 = 13 high + 13 low
+// (650ns/650ns). Cell=1.30us. Eight symbols occupy exactly 26 bytes,
+// so consecutive bytes/pixels have no artificial gaps. MSB first.
+#define WS2805_ENCODED_BYTES 26
+#define WS2805_RESET_BYTES 800 // 320us at 20MHz, margin above >280us
+// Hardware-verified: each WS2805 consumes 48 bits per pixel - five 8-bit
+// channels plus one trailing pad byte (NeoPixelBus Neo6xByteFeature). The
+// pad byte is always sent as 0. Five-byte frames shift colours between ICs.
+#define WS2805_CHANNELS 5
+#define WS2805_WIRE_BYTES_PER_PIXEL 6
+static void WS2805_EncodeByte(uint8_t value, uint8_t *dst) {
+	memset(dst, 0, WS2805_ENCODED_BYTES);
+	for (unsigned int bit = 0; bit < 8; bit++) {
+		unsigned int high = (value & (0x80U >> bit)) ? 13 : 7;
+		for (unsigned int i = 0; i < high; i++) {
+			unsigned int pos = bit * 26 + i;
+			dst[pos / 8] |= 0x80U >> (pos % 8);
+		}
+	}
+}
